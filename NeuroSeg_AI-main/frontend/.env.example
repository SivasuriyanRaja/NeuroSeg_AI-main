# NeuroSeg AI — Frontend Environment Variables
#
# Copy this file to .env.local for local overrides.
# On Vercel, add these in: Project Settings → Environment Variables
#
# The URL of your deployed NeuroSeg AI backend (FastAPI).
# Leave empty to use the local Vite dev proxy (/api → http://127.0.0.1:8000)
#
# Example (Render, Railway, etc.):
VITE_API_URL=https://your-backend-url.onrender.com/api

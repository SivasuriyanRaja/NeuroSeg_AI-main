# NeuroSeg AI — Frontend Environment Variables
#
# Copy this file to .env.local for local overrides.
# On Vercel, add these in: Project Settings → Environment Variables
#
# The URL of your deployed NeuroSeg AI backend on Render (FastAPI).
# Leave empty in local dev to use Vite dev proxy (/api → http://127.0.0.1:8000)
#
VITE_API_URL=https://neuroseg-ai-main.onrender.com/api

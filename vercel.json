{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "NeuroSeg_AI-main/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/:match*/",
      "destination": "https://neuroseg-ai-main.onrender.com/api/:match*/"
    },
    {
      "source": "/api/:match*",
      "destination": "https://neuroseg-ai-main.onrender.com/api/:match*"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://neuroseg-ai-main.onrender.com/api/$1"
    },
    {
      "source": "/api",
      "destination": "https://neuroseg-ai-main.onrender.com/api"
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
